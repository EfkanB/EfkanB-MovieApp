# MovieApp backend ortam değişkenleri
# Bu dosyayı .env olarak kopyala ve değerleri doldur. .env dosyasını ASLA commit'leme.

# --- Veritabanı ---
# Neon/Render gibi platformların verdiği tek adres de kullanılabilir (DB_URL boşsa okunur):
# DATABASE_URL=postgresql://kullanici:sifre@sunucu/veritabani?sslmode=require
# Ya da aşağıdaki gibi ayrı ayrı (MySQL)
# Yayında PostgreSQL (Neon) için: jdbc:postgresql://<host>/<db>?sslmode=require
# Yerelde MySQL için aşağıdaki örnek; DB ayrı sunucudaysa sslMode=REQUIRED kullan
DB_URL=jdbc:mysql://localhost:3306/movieapp?createDatabaseIfNotExist=true&sslMode=REQUIRED&serverTimezone=UTC
DB_USERNAME=movieapp_user
DB_PASSWORD=

# --- JWT ---
# En az 32 karakter, rastgele. Üretmek için: openssl rand -base64 48
JWT_SECRET=
# Token geçerlilik süresi (ms). Varsayılan 24 saat.
JWT_EXPIRATION_MS=86400000

# --- CORS ---
# Frontend'in yayındaki adresi (virgülle birden fazla yazılabilir). "*" kabul edilmez.
CORS_ALLOWED_ORIGINS=https://senin-alan-adin.com

# --- Mail ---
# Yayında (Render free) SMTP engelli: Brevo API anahtarı ver, mailler HTTP ile gider.
BREVO_API_KEY=
# Yerelde Gmail SMTP kullanmak istersen BREVO_API_KEY'i boş bırak ve aşağıyı doldur.
# Gmail SMTP
# MAIL_PASSWORD normal Gmail şifren değil, Google hesabından alınan "Uygulama şifresi" olmalı
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM=

# Şifre sıfırlama mailindeki link
FRONTEND_RESET_PASSWORD_URL=https://senin-alan-adin.com/reset-password

# --- Proxy ---
# Nginx arkasında "native" kalsın (gerçek istemci IP'si rate limit için kullanılır)
FORWARD_HEADERS_STRATEGY=native
